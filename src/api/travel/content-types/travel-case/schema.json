{
  "kind": "collectionType",
  "collectionName": "travel_cases",
  "info": {
    "singularName": "travel-case",
    "pluralName": "travel-cases",
    "displayName": "Trámite de viaje"
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "pet": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::pet.pet"
    },
    "destinationCountry": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::shared.country"
    },
    "airline": {
      "type": "string",
      "maxLength": 100
    },
    "travelOn": {
      "type": "date",
      "required": true
    },
    "state": {
      "type": "enumeration",
      "enum": [
        "initiated",
        "docs_collected",
        "vet_check_passed",
        "ready_to_fly",
        "completed",
        "cancelled"
      ],
      "default": "initiated",
      "required": true
    },
    "requirements": {
      "type": "dynamiczone",
      "components": [
        "travel.health-certificate",
        "travel.rabies-titer",
        "travel.microchip-check",
        "travel.antiparasitic",
        "travel.import-permit",
        "travel.crate",
        "travel.other-requirement"
      ]
    }
  }
}
