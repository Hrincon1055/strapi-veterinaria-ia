{
  "collectionName": "components_clinical_service_lines",
  "info": { "displayName": "Servicio", "icon": "handHeart", "description": "Servicio del catálogo realizado o recomendado en la consulta." },
  "options": {},
  "attributes": {
    "service": { "type": "relation", "relation": "manyToOne", "target": "api::scheduling.service" },
    "quantity": { "type": "decimal", "required": true, "default": 1, "min": 0.01 },
    "state": { "type": "enumeration", "enum": ["applied", "recommended"], "default": "applied", "required": true },
    "notes": { "type": "text" },
    "label": { "type": "string", "maxLength": 255 },
    "lineKey": { "type": "string", "maxLength": 36 }
  }
}
